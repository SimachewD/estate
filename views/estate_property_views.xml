<odoo>
    <!-- Tree view -->
    <record id="view_estate_property_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree decoration-success="state in ['offer_received','offer_accepted']" decoration-bf="state == 'offer_accepted'" decoration-muted="state == 'sold'">
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="property_type_id"/>
                <field name="currency_id" invisible="1"/>
                <field name="expected_price" widget="monetary" options="{'currency_field': 'currency_id', 'display_currency_symbol': True}"/>
                <field name="selling_price" widget="monetary" options="{'currency_field': 'currency_id', 'display_currency_symbol': True}"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="state"/>
                <!-- OPTIONAL FIELD -->
                <field name="total_area" optional="show"/> 
            </tree>
        </field>
    </record>

    <!-- Form view with notebook -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_sold" type="object" class="btn-primary" string="Sold" attrs="{'invisible': ['|', ('state', '=', 'sold'), ('state', '=', 'canceled')]}"/>
                    <button name="action_cancel" type="object" class="btn-secondary" string="Cancel" attrs="{'invisible': [('state', '=', 'canceled')]}"/>

                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="0"/>
                            <field name="expected_price" widget="monetary" options="{'currency_field': 'currency_id', 'display_currency_symbol': True}"/>
                            <field name="selling_price" widget="monetary" options="{'currency_field': 'currency_id', 'display_currency_symbol': True}"/>
                            <field name="best_price" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_availability"/>
                            <field name="postcode_id"/>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="facades"/>
                            <field name="total_area" readonly="1"/>
                        </group>
                    </group>

                    <!-- Notebook Tabs -->
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>

                        <page string="Garden &amp; Garage">
                            <group>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" attrs="{'invisible': [('garden','=',False)]}"/>
                                <field name="garden_orientation" attrs="{'invisible': [('garden','=',False)]}" widget="radio"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids" attrs="{'readonly': [('state', 'in', ['offer_accepted', 'sold', 'canceled'])]}">
                                <tree editable="bottom" string="Offers">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <button name="action_accept" string="Accept" type="object" icon="fa-check" attrs="{'invisible': [('status', 'in', ['accepted','refused'])]}"/>
                                    <button name="action_refuse" string="Refuse" type="object" icon="fa-times" attrs="{'invisible': [('status', 'in', ['accepted','refused'])]}"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Sales Information">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>

                        <page string="Additional Info">
                            <group>
                                <field name="create_date" readonly="1"/>
                                <field name="write_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                 <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search, filters and groups -->
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <!-- Searchable fields -->
                <field name="name" string="Title"/>
                <field name="property_type_id"/>
                <field name="postcode_id"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <!-- <field name="living_area"/> -->
                <field name="facades"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>

                <!-- Filters -->
                <filter name="garden" string="With Garden" domain="[('garden','=',True)]"/>
                <filter name="garage" string="With Garage" domain="[('garage','=',True)]"/>
                <filter name="available" string="Available" domain="[('state','in',['new','offer_received'])]"/>
                <filter name="inactive" string="Inactive" domain="[('active','=',False)]"/>

                <!-- Group By Section -->
                <group expand="0" string="Group By">
                    <filter name="group_by_postcode" string="Postcode" context="{'group_by': 'postcode_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
        <field name="context">
            {
                'search_default_available': 1,
                'search_default_garage': True,
                'search_default_group_by_postcode': False
            }
        </field>
    </record>
</odoo>
